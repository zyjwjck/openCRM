{
  "agents": {
    "defaults": {
      "workspace": "F:\\opencrm\\openCRM\\.nanobot-workspace",
      "model": "anthropic/claude-opus-4-5",
      "provider": "auto",
      "maxTokens": 8192,
      "contextWindowTokens": 200000,
      "contextBlockLimit": null,
      "temperature": 0.1,
      "fallbackModels": [],
      "maxToolIterations": 200,
      "maxConcurrentSubagents": 1,
      "failOnToolError": true,
      "maxToolResultChars": 16000,
      "providerRetryMode": "standard",
      "toolHintMaxLength": 40,
      "reasoningEffort": null,
      "timezone": "Asia/Shanghai",
      "timezoneMode": "auto",
      "botName": "nanobot",
      "botIcon": "🐈",
      "unifiedSession": false,
      "disabledSkills": [],
      "idleCompactAfterMinutes": 15,
      "idleCompactCheckIntervalSeconds": 60,
      "consolidationRatio": 0.5,
      "dream": {
        "enabled": true,
        "intervalH": 2,
        "modelOverride": null
      }
    }
  },
  "channels": {
    "sendProgress": true,
    "sendToolHints": true,
    "showReasoning": true,
    "extractDocumentText": true,
    "sendMaxRetries": 3,
    "websocket": {
      "enabled": true,
      "host": "127.0.0.1",
      "port": 8765,
      "path": "/",
      "publicWsUrl": "",
      "token": "",
      "websocketRequiresToken": false,
      "allowFrom": ["*"],
      "streaming": true
    }
  },
  "gateway": {
    "host": "127.0.0.1",
    "port": 18790,
    "restartMode": "auto",
    "heartbeat": {
      "enabled": true,
      "intervalS": 1800
    }
  },
  "api": {
    "host": "127.0.0.1",
    "port": 8900,
    "timeout": 120.0,
    "apiKey": ""
  },
  "tools": {
    "web": {
      "enable": true,
      "search": { "provider": "duckduckgo", "maxResults": 5, "timeout": 30 },
      "fetch": { "useJinaReader": true }
    },
    "exec": {
      "enable": true,
      "timeout": 60
    },
    "file": { "enable": true },
    "cliApps": { "enable": true },
    "my": { "enable": true, "allowSet": false },
    "restrictToWorkspace": false,
    "webuiAllowLocalServiceAccess": true,

    "mcpServers": {
      "openCRM": {
        "type": "streamableHttp",
        "url": "http://127.0.0.1:8001/mcp",
        "toolTimeout": 30,
        "enabledTools": ["*"]
      }
    },
    "ssrfWhitelist": ["127.0.0.1/32", "10.0.0.0/8", "192.168.0.0/16"]
  },
  "modelPresets": {
    "claude-opus-4-5": {
      "label": "claude-opus-4-5",
      "model": "anthropic/claude-opus-4-5",
      "provider": "auto",
      "maxTokens": 8192,
      "contextWindowTokens": 200000,
      "temperature": 0.1
    }
  }
